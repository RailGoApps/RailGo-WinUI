<Application
    x:Class="RailGo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="RowDetailsBackgroundBrush" Color="#FF272727" />
                    <SolidColorBrush x:Key="RowDetailsBorderBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="RowDetailsLinkForegroundBrush" Color="#FFFFC94D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RowDetailsBackgroundBrush" Color="#FFF7F7F7" />
                    <SolidColorBrush x:Key="RowDetailsBorderBrush" Color="#FFE3E3E3" />
                    <SolidColorBrush x:Key="RowDetailsLinkForegroundBrush" Color="#FFB35C00" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- DataGrid 默认把行详情区域绘制成白色，这里统一改为主题色 -->
            <Style TargetType="primitives:DataGridDetailsPresenter">
                <Setter Property="Background" Value="{ThemeResource RowDetailsBackgroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
