<Page
    x:Class="RailGo.Views.Pages.TrainEmus.EMU_RoutingDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:SettingsControls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="5" VerticalAlignment="Top">
            <TextBlock Text="{x:Bind ViewModel.TrainEmuModel, Mode=OneWay}"
                       FontSize="36"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{x:Bind ViewModel.TrainEmuCode, Mode=OneWay}"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{x:Bind ViewModel.TrainBelong, Mode=OneWay}"
                       FontSize="18"
                       Margin="0,20,0,10"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{x:Bind ViewModel.TrainMaker, Mode=OneWay}"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <Button Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ViewAtlasImageCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEB9F;" FontSize="16"/>
                    <TextBlock Text="查看车型图片"/>
                </StackPanel>
            </Button>

            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ViewCoachPicBtn_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7C0;" FontSize="16"/>
                    <TextBlock Text="查看列车车厢图"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 分隔线 -->
        <Rectangle Grid.Column="1" Fill="LightGray" Width="1" HorizontalAlignment="Center"/>

        <!-- 右侧：交路表 -->
        <Grid Grid.Column="2" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="交路表（可上下滚动查看完整信息）"
                       Margin="0,0,0,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Grid Grid.Row="1">
                <Grid.Resources>
                    <DataTemplate x:Key="EmuTrainsTemplate">
                        <Border Background="{ThemeResource RowDetailsBackgroundBrush}"
                                BorderBrush="{ThemeResource RowDetailsBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="4,2"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <HyperlinkButton Margin="10,10" x:Uid="TrainNumberDetails" Foreground="{ThemeResource RowDetailsLinkForegroundBrush}" Click="TrainNumberDetailsBtn_Click"/>
                                <HyperlinkButton Margin="10,10" x:Uid="TrainEmuDetails" Foreground="{ThemeResource RowDetailsLinkForegroundBrush}" Click="TrainEmuDetailsBtn_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <controls:DataGrid x:Name="EmuDataGrid"
                       AutoGenerateColumns="False"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       VerticalScrollBarVisibility="Visible"
                       HorizontalScrollBarVisibility="Visible"
                       IsReadOnly="True"
                       RowDetailsTemplate="{StaticResource EmuTrainsTemplate}"
                       RowDetailsVisibilityMode="VisibleWhenSelected"
                       ItemsSource="{x:Bind ViewModel.TrainEmuInfos, Mode=OneWay}"
                       SelectedItem="{x:Bind _item, Mode=TwoWay}">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Binding="{Binding EmuNoFull}" x:Uid="emu_no_Header" />
                        <controls:DataGridTextColumn Binding="{Binding TrainNo}" x:Uid="train_no_Header" />
                        <controls:DataGridTextColumn Binding="{Binding Date}" x:Uid="date_Header" />
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Grid>
        </Grid>

        <!-- 加载指示器 -->
        <muxc:ProgressRing Grid.ColumnSpan="3"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="60"
                          Height="60"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
    </Grid>
</Page>
