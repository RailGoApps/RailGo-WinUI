<Page
    x:Class="RailGo.Views.Pages.Shell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:ButtonModel="using:RailGo.Core.Models.Controls"
    xmlns:helpers="using:RailGo.Helpers"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <helpers:StringToGeometryConverter x:Key="StringToGeometryConverter"/>
        <Style x:Key="FeatureButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundPointerOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundPressed}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FeatureButtonTemplate" x:DataType="ButtonModel:FeatureButtonData">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Row="0" Grid.Column="0"
                      Data="{Binding IconPath, Converter={StaticResource StringToGeometryConverter}}"
                      Fill="{ThemeResource TextFillColorPrimaryBrush}"
                      Stretch="Uniform"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                          Text="{Binding Title}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                          Text="{Binding Description}"
                          FontSize="12"
                          Foreground="Gray"
                          TextWrapping="Wrap"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"/>

                <FontIcon Grid.Row="3" Grid.Column="1"
                         Glyph="&#xE76C;"
                         FontSize="16"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollMode="Auto" 
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled">
            <Grid x:Name="ContentArea" SizeChanged="OnContentAreaSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <InfoBar
                    IsOpen="True"
                    Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                    IsClosable="False"
                    Message="{x:Bind ViewModel.CurrentNotice, Mode=TwoWay}">
                        <InfoBar.ActionButton>
                            <HyperlinkButton Content="查看全部"  Click="ShowAllNoticesButton_Click"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>

                <Grid Grid.Row="1">
                    <controls:FlipView x:Name="BannerFlipView"
                                  ItemsSource="{x:Bind ViewModel.BannerImages, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.CurrentBannerIndex, Mode=TwoWay}"
                                  SelectionChanged="BannerFlipView_SelectionChanged">
                        <controls:FlipView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Viewbox Stretch="Uniform" MaxHeight="{Binding MaxBannerHeight, Mode=OneWay}">
                                    <Image Source="{x:Bind}" 
                                       Stretch="None"
                                       Tapped="BannerImage_Tapped"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                </Viewbox>
                            </DataTemplate>
                        </controls:FlipView.ItemTemplate>
                    </controls:FlipView>

                    <ItemsControl HorizontalAlignment="Center" 
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,10"
                             ItemsSource="{x:Bind ViewModel.BannerImages, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="8" 
                                   Height="8" 
                                   Margin="4" 
                                   CornerRadius="4"
                                   Background="White"
                                   Opacity="0.7"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <StackPanel Margin="0,20,0,20" Grid.Row="2">
                    <TextBlock>
                    <Bold>功能列表</Bold>
                    </TextBlock>
                    <ScrollViewer
                         HorizontalScrollMode="Auto"
                         HorizontalScrollBarVisibility="Hidden"
                         VerticalScrollMode="Disabled"
                         VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Left" 
                           VerticalAlignment="Top" 
                           Orientation="Horizontal"
                           Margin="0,5,0,5">

                            <Button x:Name="ToTrainEmusButton" 
                            Command="{x:Bind ViewModel.NavigationCommand}" 
                            CommandParameter="{x:Bind ToTrainEmusButton.Name}"
                            Style="{StaticResource FeatureButtonStyle}"
                            ContentTemplate="{StaticResource FeatureButtonTemplate}">
                                <Button.Content>
                                    <ButtonModel:FeatureButtonData 
                                IconPath="F0 M2,11 C2,8.5 4,7 6.5,7 H15 C17,7 18.5,8 19.5,10 L19.5,14.5 H2 Z M4.5,9.5 H18 L18,11 H4.5 Z M6,14.5 A1.5,1.5 0 1 0 6,17.5 A1.5,1.5 0 1 0 6,14.5 Z M16,14.5 A1.5,1.5 0 1 0 16,17.5 A1.5,1.5 0 1 0 16,14.5 Z M8,18 H9.5 V19 H8 Z M11,18 H12.5 V19 H11 Z M14,18 H15.5 V19 H14 Z"
                                Title="动车组交路"
                                Description="查询动车组配属和运行交路。"/>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ToTrainsButton" 
                            Command="{x:Bind ViewModel.NavigationCommand}" 
                            CommandParameter="{x:Bind ToTrainsButton.Name}"
                            Style="{StaticResource FeatureButtonStyle}"
                            ContentTemplate="{StaticResource FeatureButtonTemplate}">
                                <Button.Content>
                                    <ButtonModel:FeatureButtonData 
                                IconPath="F0 M3,11 C3,8.5 5,7 7.5,7 H13 C15,7 16.5,8 17.5,10 L17.5,14.5 H3 Z M5,9.5 H16 L16,11 H5 Z M6.5,14.5 A1.5,1.5 0 1 0 6.5,17.5 A1.5,1.5 0 1 0 6.5,14.5 Z M14,14.5 A1.5,1.5 0 1 0 14,17.5 A1.5,1.5 0 1 0 14,14.5 Z M18,13 A2,2 0 1 0 18,17 A2,2 0 1 0 18,13 Z M19.4,16.4 L22,19 L21,20 L18.4,17.4 Z"
                                Title="车次查询"
                                Description="查询时刻、开行日等信息。"/>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ToStationsButton" 
                                Command="{x:Bind ViewModel.NavigationCommand}" 
                                CommandParameter="{x:Bind ToStationsButton.Name}"
                                Style="{StaticResource FeatureButtonStyle}"
                                ContentTemplate="{StaticResource FeatureButtonTemplate}">
                                <Button.Content>
                                    <ButtonModel:FeatureButtonData 
                                    IconPath="F0 M12,2.5 L22,9 H2 Z M3,9.5 H21 V11 H3 Z M4.5,11.5 H7.5 V20 H4.5 Z M10,11.5 H14 V20 H10 Z M16.5,11.5 H19.5 V20 H16.5 Z M2,20.5 H22 V21.5 H2 Z"
                                    Title="车站信息"
                                    Description="查询车站基础信息、大屏数据等。"/>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ToStationToStationButton" 
                                Command="{x:Bind ViewModel.NavigationCommand}" 
                                CommandParameter="{x:Bind ToStationToStationButton.Name}"
                                Style="{StaticResource FeatureButtonStyle}"
                                ContentTemplate="{StaticResource FeatureButtonTemplate}">
                                <Button.Content>
                                    <ButtonModel:FeatureButtonData 
                                    IconPath="F0 M5,3 C3,3 1.5,4.8 1.5,7 C1.5,9.8 5,13.5 5,13.5 C5,13.5 8.5,9.8 8.5,7 C8.5,4.8 7,3 5,3 Z M5,5.5 A1.5,1.5 0 1 0 5,8.5 A1.5,1.5 0 1 0 5,5.5 Z M14,11 C12,11 10.5,12.8 10.5,15 C10.5,17.8 14,21.5 14,21.5 C14,21.5 17.5,17.8 17.5,15 C17.5,12.8 16,11 14,11 Z M14,13.5 A1.5,1.5 0 1 0 14,16.5 A1.5,1.5 0 1 0 14,13.5 Z M8.5,10.5 H12 L10.5,9 Z M10.5,14.5 H8.5 L10,16 Z"
                                    Title="站到站车次查询"
                                    Description="查询两站之间的车次信息。"/>
                                </Button.Content>
                            </Button>

                            <Button x:Name="ToTrainAtlasButton"
                                Command="{x:Bind ViewModel.NavigationCommand}"
                                CommandParameter="{x:Bind ToTrainAtlasButton.Name}"
                                Style="{StaticResource FeatureButtonStyle}"
                                ContentTemplate="{StaticResource FeatureButtonTemplate}">
                                <Button.Content>
                                    <ButtonModel:FeatureButtonData
                                    IconPath="F0 M3,5 C3,3.9 3.9,3 5,3 H19 C20.1,3 21,3.9 21,5 V19 C21,20.1 20.1,21 19,21 H5 C3.9,21 3,20.1 3,19 Z M5,5 V19 H19 V5 Z M7,14 L9.5,11 L12,14 L14,12 L17,15 L17,17 L7,17 Z M8,8 A1.5,1.5 0 1 0 8,11 A1.5,1.5 0 1 0 8,8 Z"
                                    Title="列车图鉴"
                                    Description="浏览各型列车的高清图片。"/>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <ContentDialog x:Name="AllNoticesDialog"
              Title="所有系统公告"
              CloseButtonText="关闭">
            <ScrollViewer VerticalScrollMode="Auto" 
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollMode="Disabled">
                <ListView x:Name="AllNoticesListView"
                 ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}"
                 SelectionMode="None"
                 IsItemClickEnabled="False"
                 BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Margin="0,8,0,8">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                   CornerRadius="8">
                                    <TextBlock Text="{x:Bind}"
                                      TextWrapping="WrapWholeWords"
                                      FontSize="14"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
