<Page
    x:Class="RailGo.Views.Pages.Settings.DataSources.DataSources_MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:RailGo.Helpers"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:local="using:RailGo.Helpers"
    mc:Ignorable="d">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentArea" Margin="{StaticResource SmallTopBottomMargin}">
                <TextBlock Text="数据源模式" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="{StaticResource XSmallTopMargin}"/>

                <!-- 在线模式 -->
                <controls:SettingsCard
                    Header="在线模式"
                    Description="使用时需要联网，离线状态下不可用。数据最新，但有可能不全。"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE701;}"
                    Margin="{StaticResource XSmallTopMargin}">
                    <RadioButton
                        x:Name="OnlineModeRadio"
                        Content="使用在线模式"
                        IsChecked="{x:Bind ViewModel.IsOnlineMode, Mode=TwoWay}"
                        Checked="OnlineModeRadio_Checked"/>
                </controls:SettingsCard>

                <!-- 离线模式 -->
                <controls:SettingsCard
                    Header="离线模式"
                    Description="无网状态下可以使用，数据较全，更新缓慢。"
                    HeaderIcon="{ui:FontIcon Glyph=&#xEDA2;}"
                    Margin="{StaticResource XSmallTopMargin}">
                    <StackPanel Spacing="12">
                        <RadioButton
                            x:Name="OfflineModeRadio"
                            Content="使用离线模式"
                            IsChecked="{x:Bind ViewModel.IsOfflineMode, Mode=TwoWay}"
                            Checked="OfflineModeRadio_Checked"/>

                        <!-- 离线模式下才显示的内容 -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsOfflineMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="12">
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Warning"
                                Title="提示"
                                Message="动车组图片及列车图鉴等在线功能将无法使用。"/>

                            <controls:SettingsCard
                                Header="离线数据库"
                                Description="选择本地 railgo.sqlite 数据库文件"
                                HeaderIcon="{ui:FontIcon Glyph=&#xE8A1;}">
                                <StackPanel Spacing="8">
                                    <TextBox
                                        x:Name="DatabasePathTextBox"
                                        PlaceholderText="未选择数据库文件"
                                        Text="{x:Bind ViewModel.OfflineDatabasePath, Mode=TwoWay}"
                                        IsReadOnly="True"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="选择文件" Click="SelectDatabaseFile_Click" Style="{StaticResource AccentButtonStyle}"/>
                                        <Button Content="下载离线数据库" Click="DownloadDatabase_Click"/>
                                    </StackPanel>
                                    <InfoBar
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Title="提示"
                                        Message="下载时请选择更新日期最近的版本，推荐一个月左右检查一次数据库版本更新。"
                                        Visibility="{x:Bind ViewModel.IsOfflineMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>
                    </StackPanel>
                </controls:SettingsCard>

                <!-- 在线模式下显示下载按钮 -->
                <controls:SettingsCard
                    Header="下载离线数据库"
                    Description="如需使用离线模式，请先下载离线数据库。"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE896;}"
                    Margin="{StaticResource XSmallTopMargin}"
                    Visibility="{x:Bind ViewModel.IsOnlineMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <Button Content="前往下载" Click="DownloadDatabase_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="提示"
                            Message="下载时请选择更新日期最近的版本，推荐一个月左右检查一次数据库版本更新。"/>
                    </StackPanel>
                </controls:SettingsCard>

                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Margin="{StaticResource XSmallTopMargin}"
                    Severity="Informational"
                    Title="当前模式"
                    Message="{x:Bind ViewModel.QuerySource, Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 切换离线模式确认对话框 -->
        <ContentDialog
            x:Name="SwitchToOfflineDialog"
            Title="确认切换"
            PrimaryButtonText="确认切换"
            CloseButtonText="取消"
            DefaultButton="Close">
            <TextBlock Text="即将切换到离线模式，动车组图片及列车图鉴等在线功能将无法使用，请确认切换。" TextWrapping="WrapWholeWords"/>
        </ContentDialog>
    </Grid>
</Page>
