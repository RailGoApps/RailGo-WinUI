<Page
    x:Class="RailGo.Views.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:RailGo.Helpers"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentArea">
                <InfoBar
                    x:Name="BackgroundErrorInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Error"
                    Title="背景设置失败"
                    Margin="{StaticResource XSmallTopMargin}" />

                <!-- 数据源设置 -->
                <StackPanel Margin="{StaticResource SmallTopBottomMargin}">
                    <TextBlock Text="数据源设置" Style="{ThemeResource SubtitleTextBlockStyle}" 
                               Margin="{StaticResource XSmallTopMargin}"/>
                    <controls:SettingsCard x:Name="DataSourcesSettingsCard"
                               Click="OnDataSourcesSettingsCardClicked"
                               Description="设置离线数据库，数据源集合，以及第三方数据等"
                               Header="数据源设置"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE8A1;}"
                               IsClickEnabled="True"
                               Margin="{StaticResource XSmallTopMargin}">
                    </controls:SettingsCard>
                </StackPanel>

                <!-- 个性化 -->
                <TextBlock x:Uid="Settings_Personalization" Style="{ThemeResource SubtitleTextBlockStyle}" 
                           Margin="{StaticResource XSmallTopMargin}"/>
                <StackPanel Margin="{StaticResource SmallTopBottomMargin}">
                    <controls:SettingsCard
                               Description="颜色模式选择，选择浅色，深色，或跟随系统"
                               Header="颜色模式选择"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE793;}"
                               Margin="{StaticResource XSmallTopMargin}">
                        <ComboBox
                                x:Name="ThemeComboBox"
                                Margin="{StaticResource XSmallTopMargin}"
                                SelectionChanged="ThemeComboBox_SelectionChanged"
                                FontSize="15">
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                            <ComboBoxItem Content="跟随系统" Tag="Default" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Description="选择本地图片作为软件背景，可随时恢复默认背景"
                               Header="背景图片"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE91B;}"
                               Margin="{StaticResource XSmallTopMargin}">
                        <StackPanel Margin="{StaticResource XSmallTopMargin}" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="选择图片" Click="OnChooseBackgroundImageClicked" />
                                <Button x:Name="ClearBackgroundButton" Content="恢复默认" Click="OnClearBackgroundImageClicked" />
                            </StackPanel>
                            <TextBlock
                                x:Name="BackgroundImagePathTextBlock"
                                Text="当前：默认背景"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- 链接与功能 -->
                <TextBlock Text="链接与功能" Style="{ThemeResource SubtitleTextBlockStyle}" 
                           Margin="{StaticResource XSmallTopMargin}"/>
                <StackPanel Margin="{StaticResource SmallTopBottomMargin}">
                    <controls:SettingsCard
                               Description="访问 RailGo 官方网站获取更多信息"
                               Header="打开官网"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE774;}"
                               Margin="{StaticResource XSmallTopMargin}"
                               IsClickEnabled="True"
                               Click="OnOpenWebsiteClicked">
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Description="访问 RailGo Center 管理中心"
                               Header="RailGo Center"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE9AC;}"
                               Margin="{StaticResource XSmallTopMargin}"
                               IsClickEnabled="True"
                               Click="OnOpenRailGoCenterClicked">
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Description="加入官方交流群反馈问题"
                               Header="加入交流群"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE77B;}"
                               Margin="{StaticResource XSmallTopMargin}"
                               IsClickEnabled="True"
                               Click="OnJoinGroupClicked">
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Description="支持 RailGo 的持续开发与维护"
                               Header="赞助"
                               Margin="{StaticResource XSmallTopMargin}"
                               IsClickEnabled="True"
                               Click="OnSponsorClicked">
                        <controls:SettingsCard.HeaderIcon>
                            <PathIcon Data="F0 M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Description="查看参与开发、赞助与图片贡献的人员名单"
                               Header="鸣谢"
                               Margin="{StaticResource XSmallTopMargin}"
                               IsClickEnabled="True"
                               Click="OnAcknowledgementsClicked">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- 关于 -->
                <TextBlock x:Uid="Settings_About" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Margin="{StaticResource XSmallTopMargin}">
                    <controls:SettingsCard
                               Header="版本信息"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE7C1;}"
                               Margin="{StaticResource XSmallTopMargin}">
                        <TextBlock Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" 
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Header="关于 RailGo"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE946;}"
                               Margin="{StaticResource XSmallTopMargin}">
                        <StackPanel>
                            <TextBlock
                                x:Uid="Settings_AboutDescription"
                                Margin="{StaticResource XSmallTopMargin}"
                                Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock
                                Text="AZ Studio 版权所有"
                                Margin="{StaticResource XSmallTopMargin}"
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                               Header="隐私政策"
                               HeaderIcon="{ui:FontIcon Glyph=&#xE72E;}"
                               Margin="{StaticResource XSmallTopMargin}">
                        <HyperlinkButton x:Uid="SettingsPage_PrivacyTermsLink" />
                    </controls:SettingsCard>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 加入交流群对话框 -->
        <ContentDialog x:Name="JoinGroupDialog"
                       Title="加入交流群"
                       CloseButtonText="关闭"
                       PrimaryButtonText="复制群号"
                       PrimaryButtonClick="OnCopyGroupNumberClicked">
            <StackPanel>
                <TextBlock TextWrapping="WrapWholeWords" Margin="0,0,0,12">
                    复制群号加入群聊【RailGo 官方反馈 | 重拳出击盗版中】652032716
                </TextBlock>
                <TextBlock Text="群号：652032716" 
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </ContentDialog>

        <!-- 赞助对话框 -->
        <ContentDialog x:Name="SponsorDialog"
                       Title="赞助 RailGo"
                       CloseButtonText="关闭"
                       DefaultButton="Close">
            <StackPanel Spacing="12">
                <TextBlock TextWrapping="WrapWholeWords">
                    感谢你对 RailGo 的支持，你的每一份赞助都会用于软件的持续开发与维护。
                </TextBlock>
                <Border
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                    <ScrollViewer
                        MaxHeight="420"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Image
                            Source="/Assets/Sponsor.jpg"
                            MaxWidth="400"
                            Stretch="Uniform"
                            AutomationProperties.Name="赞助二维码" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
