<Page
    x:Class="RailGo.Views.Pages.StationToStation.StationToStationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:SettingsControls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" x:Name="TopBar">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4">
                        <TextBlock><Bold>始发站：</Bold></TextBlock>
                        <StackPanel x:Name="FromKeywordPanel" Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Width="220"
                                PlaceholderText="输入车站名或车站电报码"
                                Text="{x:Bind ViewModel.FromStationKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="StationKeyword_KeyDown"/>
                            <Button Click="SearchFromStationBtn_Click" ToolTipService.ToolTip="搜索始发站">
                                <FontIcon Glyph="&#xE721;"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Button HorizontalAlignment="Center" VerticalAlignment="Center" Click="SwitchFromAndToButton_Click" ToolTipService.ToolTip="交换始发/终到">
                    <FontIcon Glyph="&#xE8AB;"/>
                </Button>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4">
                        <TextBlock><Bold>终到站：</Bold></TextBlock>
                        <StackPanel x:Name="ToKeywordPanel" Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Width="220"
                                PlaceholderText="输入车站名或电报码"
                                Text="{x:Bind ViewModel.ToStationKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="StationKeyword_KeyDown"/>
                            <Button Click="SearchToStationBtn_Click" ToolTipService.ToolTip="搜索终到站">
                                <FontIcon Glyph="&#xE721;"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <CalendarDatePicker PlaceholderText="选择日期" HorizontalAlignment="Center" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"/>
                <CheckBox Content="是否允许包含同城车站" IsChecked="{x:Bind ViewModel.AllowCitysIsOpen, Mode=TwoWay}"/>
                <Button HorizontalAlignment="Stretch"
                    Content="查询"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SearchButton_Click"/>
            </StackPanel>
        </Grid>

        <Popup x:Name="FromSuggestionPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="True"
               IsOpen="{x:Bind ViewModel.FromSuggestionOpen, Mode=TwoWay}"
               Opened="FromSuggestionPopup_Opened">
            <Border Width="300"
                    CornerRadius="6"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ListBox ItemsSource="{x:Bind ViewModel.FromStationSuggestions, Mode=OneWay}"
                         SelectedItem="{x:Bind ViewModel.SelectedFromSuggestion, Mode=TwoWay}"
                         MaxHeight="240"
                         Padding="0"
                         BorderThickness="0"
                         Background="{x:Null}"
                         SelectionChanged="FromSuggestionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TeleCode}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding PinyinTriple}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- 终到站候选悬浮 Popup -->
        <Popup x:Name="ToSuggestionPopup"
               IsLightDismissEnabled="True"
               ShouldConstrainToRootBounds="True"
               IsOpen="{x:Bind ViewModel.ToSuggestionOpen, Mode=TwoWay}"
               Opened="ToSuggestionPopup_Opened">
            <Border Width="300"
                    CornerRadius="6"
                    Padding="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ListBox ItemsSource="{x:Bind ViewModel.ToStationSuggestions, Mode=OneWay}"
                         SelectedItem="{x:Bind ViewModel.SelectedToSuggestion, Mode=TwoWay}"
                         MaxHeight="240"
                         Padding="0"
                         BorderThickness="0"
                         Background="{x:Null}"
                         SelectionChanged="ToSuggestionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TeleCode}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding PinyinTriple}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <Grid Grid.Row="1" Margin="60,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <DataTemplate x:Key="RowDetailsTemplate">
                    <Border Background="{ThemeResource RowDetailsBackgroundBrush}"
                            BorderBrush="{ThemeResource RowDetailsBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="4,2"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <HyperlinkButton Margin="10,10" Content="查看车次详情" Foreground="{ThemeResource RowDetailsLinkForegroundBrush}" Click="DetailsBtn_Click" x:Name="TrainDetail_Btn"/>
                            <HyperlinkButton Margin="10,10" Content="查看途径起点车站详情" Foreground="{ThemeResource RowDetailsLinkForegroundBrush}" Click="DetailsBtn_Click" x:Name="FromStationDetail_Btn"/>
                            <HyperlinkButton Margin="10,10" Content="查看途径终点车站详情" Foreground="{ThemeResource RowDetailsLinkForegroundBrush}" Click="DetailsBtn_Click" x:Name="ToStationDetail_Btn"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </Grid.Resources>
            <controls:DataGrid Grid.Row="0"
                 ItemsSource="{x:Bind ViewModel.TrainResults, Mode=OneWay}"
                 AutoGenerateColumns="False"
                 VerticalScrollBarVisibility="Visible"
                 HorizontalScrollBarVisibility="Visible"
                 RowDetailsTemplate="{StaticResource RowDetailsTemplate}"
                 RowDetailsVisibilityMode="VisibleWhenSelected"
                 SelectedItem="{x:Bind _item, Mode=TwoWay}">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="车次" Binding="{Binding Number}" />
                    <controls:DataGridTextColumn Header="途径起点" Binding="{Binding FromStationName}" />
                    <controls:DataGridTextColumn Header="发车时间" Binding="{Binding FromDepart}" />
                    <controls:DataGridTextColumn Header="途径终点" Binding="{Binding ToStationName}" />
                    <controls:DataGridTextColumn Header="到达时间" Binding="{Binding ToArriveTime}" />
                    <controls:DataGridTextColumn Header="历时" Binding="{Binding PassTime}" />
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <TextBlock Grid.Row="1"
                       Text="↕ 可上下滚动　↔ 可左右滑动，查看完整时刻表"
                       FontSize="12"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

    </Grid>
</Page>
