<Page
    x:Class="RailGo.Views.Pages.TrainAtlas.TrainAtlasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:RailGo.Core.Models.QueryDatas"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,20,0,10">
            <TextBox x:Name="KeywordTextBox"
                     PlaceholderText="请输入列车车型"
                     Width="320"
                     Text="{x:Bind ViewModel.Keyword, Mode=TwoWay}"
                     KeyDown="KeywordTextBox_KeyDown"/>
            <Button x:Name="SearchBtn"
                    Content="查询"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Margin="20,0,0,0"/>
            <ProgressRing Width="20" Height="20"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 图片网格 -->
        <GridView Grid.Row="1"
                  x:Name="PhotoGridView"
                  ItemsSource="{x:Bind ViewModel.Photos, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="PhotoGridView_ItemClick"
                  Margin="20,0">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:TrainAtlasPhoto">
                    <Border Width="280"
                            Margin="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <Grid Height="180" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <ProgressRing Width="32" Height="32"
                                              IsActive="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                <Image Source="{Binding ThumbnailUrl}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Opacity="0"
                                       ImageOpened="Thumbnail_ImageOpened"
                                       ImageFailed="Thumbnail_ImageFailed"/>
                                <TextBlock Text="图片加载失败"
                                           FontSize="12"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ModelName}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                    <TextBlock Text=" · "
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TrainNumber}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="12">
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="❤ "/><Run Text="{Binding LikesCount}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="👁 "/><Run Text="{Binding ViewsCount}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 分页 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,10,0,20"
                    Spacing="12">
            <Button Content="上一页"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"/>
            <TextBlock VerticalAlignment="Center"
                       FontSize="14">
                <Run Text="第 "/><Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/><Run Text=" / "/><Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}"/><Run Text=" 页"/>
            </TextBlock>
            <TextBlock VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="共 "/><Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"/><Run Text=" 张"/>
            </TextBlock>
            <Button Content="下一页"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"/>
        </StackPanel>

        <!-- 图片查看对话框 -->
        <ContentDialog x:Name="PhotoDialog"
                       Title="{x:Bind ViewModel.SelectedPhoto.Title, Mode=OneWay}"
                       CloseButtonText="关闭"
                       IsPrimaryButtonEnabled="False"
                       IsSecondaryButtonEnabled="False"
                       Opened="PhotoDialog_Opened"
                       Closed="PhotoDialog_Closed">
            <ScrollViewer MaxHeight="600"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid MinHeight="200">
                            <ProgressRing x:Name="DialogLoadingRing"
                                          Width="48" Height="48"
                                          IsActive="True"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            <Image x:Name="DialogImage"
                                   Source="{x:Bind ViewModel.SelectedPhoto.ImageUrl, Mode=OneWay}"
                                   Stretch="Uniform"
                                   MaxWidth="700"
                                   HorizontalAlignment="Center"
                                   Opacity="0"
                                   ImageOpened="DialogImage_ImageOpened"
                                   ImageFailed="DialogImage_ImageFailed"/>
                            <TextBlock x:Name="DialogImageFailedText"
                                       Text="图片加载失败"
                                       FontSize="13"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.SelectedPhoto.ModelName, Mode=OneWay}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="车次："/><Run Text="{x:Bind ViewModel.SelectedPhoto.TrainNumber, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="车站："/><Run Text="{x:Bind ViewModel.SelectedPhoto.StationName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="路局："/><Run Text="{x:Bind ViewModel.SelectedPhoto.RailwayBureau, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="拍摄日期："/><Run Text="{x:Bind ViewModel.SelectedPhoto.ShootDate, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="❤ "/><Run Text="{x:Bind ViewModel.SelectedPhoto.LikesCount, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="👁 "/><Run Text="{x:Bind ViewModel.SelectedPhoto.ViewsCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
